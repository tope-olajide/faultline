{
  "name": "faultline",
  "version": "0.1.0",
  "private": true,
  "description": "Self-improving incident intelligence on a HydraDB causal knowledge graph",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "db:up": "docker compose up -d hydradb",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f hydradb",
    "db:check": "node scripts/hydradb-compat-check.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:reset": "node scripts/seed.mjs --reset"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "geist": "^1.9.2",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  }
}
