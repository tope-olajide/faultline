# ---------------------------------------------------------------- HydraDB ----
# Self-hosted HydraDB graph-node (see docker-compose.yml).
# HTTP query API and admin/readiness ports are separate surfaces.
HYDRADB_HTTP_URL=http://127.0.0.1:8443
HYDRADB_ADMIN_URL=http://127.0.0.1:9090
HYDRADB_BOLT_URL=bolt://127.0.0.1:7687

# Bearer token. The value below is the documented local-development default.
# Deployed instances must supply their own token and require TLS.
HYDRADB_TOKEN=local-development-token-32-bytes
HYDRADB_GRAPH_ID=default
HYDRADB_CELL_ID=cell-0
HYDRADB_NAMESPACE=default

# ---------------------------------------------------------- Alert intake ----
# Unset disables POST /api/alerts. Set 16+ characters to enable token-protected
# inbound alert creation (Bearer or x-faultline-token).
# FAULTLINE_ALERT_TOKEN=

# ------------------------------------------------------------- Demo scope ----
# The demo workspace is a single tenant/project/environment scope. Every graph
# entity id is derived from this scope, so different scopes never collide.
FAULTLINE_TENANT=demo
FAULTLINE_PROJECT=checkout-platform
FAULTLINE_ENVIRONMENT=production
